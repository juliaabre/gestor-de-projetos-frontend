# Raiz do backend usada pelo navegador. Deixe vazio em desenvolvimento para
# usar o proxy do Vite (evita CORS). Em produção, informe a raiz do servidor,
# SEM "/api" no final (ex.: https://api.exemplo.com).
VITE_API_BASE_URL=

# Para onde o proxy do Vite encaminha /api em desenvolvimento.
VITE_API_PROXY_TARGET=http://localhost:8080

# Somente para desenvolvimento local: habilita o login sem backend.
VITE_ENABLE_MOCK_AUTH=false
VITE_MOCK_AUTH_EMAIL=
VITE_MOCK_AUTH_PASSWORD=
